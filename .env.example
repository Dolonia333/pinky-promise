# Names only. Put real values in .env or the host's secret settings. Never commit them.

# Postgres connection string. A Supabase pooler URL works here.
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
VITE_AUTH_ENABLED=true

# GitHub is the main sign-in. Email stays as the backup.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Report text falls back to the shared rules when this is empty.
AI_PROVIDER_KEY=
